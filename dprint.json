{
  "lineWidth": 80,
  "indentWidth": 2,
  "biome": {
    "indentStyle": "space",
    "quoteStyle": "double"
  },
  "ruff": {
    "lineLength": 88,
    "indentWidth": 4
  },
  "excludes": [
    "**/node_modules",
    "**/.venv",
    "**/out",
    "**/dist",
    "**/.output",
    "**/.tanstack",
    "**/.turbo",
    "**/*.gen.ts",
    "packages/eta-plugin-akhook/presets",
    "**/*-lock.json",
    "bun.lock",
    "**/uv.lock",
    "**/var",
    "AGENTS.md",
    "**/.eta",
    "**/test/fixtures/**/*.js",
    "**/test/**/fixtures/**/*.js"
  ],
  "plugins": [
    "npm:@dprint/biome@0.13.13",
    "npm:@dprint/ruff@0.9.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
