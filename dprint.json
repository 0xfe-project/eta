{
  "lineWidth": 80,
  "indentWidth": 2,
  "biome": {
    "indentStyle": "space",
    "quoteStyle": "double"
  },
  "ruff": {
    "lineLength": 88,
    "indentWidth": 4
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "gofmt",
        "exts": ["go"]
      }
    ]
  },
  "excludes": [
    "vendor",
    "**/node_modules",
    "**/.venv",
    "**/out",
    "**/dist",
    "**/.output",
    "**/.tanstack",
    "**/.turbo",
    "**/routeTree.gen.ts",
    "**/*-lock.json",
    "bun.lock",
    "**/uv.lock",
    "**/go.sum",
    "**/var",
    "AGENTS.md"
  ],
  "plugins": [
    "npm:@dprint/biome@0.13.13",
    "npm:@dprint/ruff@0.9.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
  ]
}
