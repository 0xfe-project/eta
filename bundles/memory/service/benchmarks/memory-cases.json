{
  "description": "Hand-labelled diagnostic memory retrieval cases. Synthetic facts; not production memory or a representative quality benchmark.",
  "documents": [
    {
      "id": "language",
      "text": "用户偏好使用中文沟通，即使问题中包含英文技术术语。"
    },
    {
      "id": "concise",
      "text": "用户希望回答简洁，先给结论，再说明必要的依据。"
    },
    { "id": "approval", "text": "生产环境发布必须先获得 Eric 的明确批准。" },
    {
      "id": "nohup",
      "text": "生产部署脚本需要通过 nohup 运行并观察日志，防止 SSH 断开导致部署没有执行。"
    },
    { "id": "storage", "text": "AXP 的业务数据保存在 PostgreSQL 数据库中。" },
    {
      "id": "vectors",
      "text": "记忆向量存储在 PostgreSQL 的 pgvector 扩展里。"
    },
    { "id": "queue", "text": "AXP 使用 NATS 处理任务消息。" },
    {
      "id": "runtime",
      "text": "每个智能体的 Codex runtime 在独立容器中运行。"
    },
    {
      "id": "isolation",
      "text": "长期记忆按智能体隔离，网关提供的 X-AXP-Agent-Id 被用作 mem0 的 user_id。"
    },
    {
      "id": "shared",
      "text": "同一个智能体的记忆可以跨群召回，不会按当前群过滤。"
    },
    {
      "id": "source",
      "text": "记忆来源群只保存 source_group_id，群名称由界面根据当前快照查询。"
    },
    {
      "id": "extract",
      "text": "对话结束后，memory 服务使用该智能体自己的语言模型抽取长期事实。"
    },
    {
      "id": "async",
      "text": "对话记忆保存先返回 HTTP 202，再由后台队列异步处理。"
    },
    {
      "id": "embedding",
      "text": "本地向量模型 jina-embeddings-v2-base-zh 使用 CPU 推理，输出 768 维向量。"
    },
    {
      "id": "offline",
      "text": "向量模型在构建时打包进镜像，生产服务运行时不下载模型。"
    },
    {
      "id": "migration",
      "text": "更换 embedding 模型后，需要对已有记忆文本重新生成向量，不能直接混用两个模型的向量。"
    },
    {
      "id": "deletion",
      "text": "删除一条记忆前，服务先检查该记忆是否属于当前智能体。"
    },
    {
      "id": "manual",
      "text": "用户手动添加记忆时直接保存原文，不调用语言模型抽取事实。"
    },
    {
      "id": "hookfailure",
      "text": "记忆 hook 调用失败只会导致本轮没有记忆，不影响聊天本身。"
    },
    {
      "id": "queue_loss",
      "text": "记忆保存队列没有持久化，服务停止时尚未处理的对话保存会丢失。"
    },
    { "id": "telemetry", "text": "memory 服务的 mem0 遥测已关闭。" },
    {
      "id": "languagefacts",
      "text": "抽取出的事实应该保持用户原文的语言，避免中文查询与英文事实难以匹配。"
    },
    { "id": "memorylimit", "text": "memory 容器的内存上限配置为 2Gi。" },
    { "id": "polling", "text": "界面的记忆列表每 15 秒刷新一次。" },
    {
      "id": "profile",
      "text": "embedding 权重加载使 memory 服务的启动内存接近 1GiB。"
    },
    {
      "id": "threads",
      "text": "限制 ONNX 推理线程数对模型启动时的内存占用改善很小。"
    },
    {
      "id": "modelname",
      "text": "当前记忆模型使用 jinaai/jina-embeddings-v2-base-zh。"
    },
    {
      "id": "dimension",
      "text": "替换模型时，即使向量维度相同，也不代表两个模型的语义空间兼容。"
    },
    {
      "id": "teacher",
      "text": "老师只能查看自己的云盘文件，租户 IT 管理员能查看全部文件。"
    },
    {
      "id": "onboard",
      "text": "为学校老师开通账号，需要以租户 IT 管理员身份调用已有用户管理接口。"
    },
    {
      "id": "dmgintegrity",
      "text": "安装新的 Hamu DMG 前需要验证 sha256、stapler 和 Gatekeeper。"
    },
    {
      "id": "git",
      "text": "Hamu 仓库使用 conventional commits，并推送到 origin/main。"
    },
    {
      "id": "extractmodel",
      "text": "语言模型负责抽取事实，embedding 模型负责把文本转换为向量。"
    },
    { "id": "listsize", "text": "记忆列表接口每次最多读取 1000 条记录。" },
    { "id": "searchsize", "text": "记忆界面的搜索接口最多返回 50 条结果。" },
    {
      "id": "recallsize",
      "text": "聊天开始时的自动召回最多提供 5 条相关记忆。"
    },
    { "id": "score", "text": "聊天自动召回会过滤掉相关度低于 0.2 的记忆。" },
    {
      "id": "timestamp",
      "text": "新记忆使用 UTC 的 ISO 8601 时间记录创建时间。"
    },
    { "id": "health", "text": "memory 服务通过 /up 路径提供健康检查。" },
    { "id": "port", "text": "memory 服务监听容器内的 8320 端口。" },
    {
      "id": "token",
      "text": "memory 服务通过环境包令牌访问 runtime 网关的语言模型 API。"
    },
    {
      "id": "append",
      "text": "mem0 v2 采用追加写入，相同事实的新说法可能形成新的记忆。"
    },
    {
      "id": "forget",
      "text": "过时或错误的长期事实可以通过 forget 工具按记忆 ID 删除。"
    },
    {
      "id": "remember",
      "text": "智能体可以使用 remember 工具主动记录一条原文事实。"
    },
    {
      "id": "sqlite",
      "text": "mem0 的变更历史写在容器内 SQLite 中，不做持久保存。"
    },
    {
      "id": "pgversion",
      "text": "PostgreSQL 镜像使用带 pgvector 的 PostgreSQL 17 Debian trixie 版本。"
    },
    {
      "id": "pagination",
      "text": "记忆页面每页展示 20 条记录，切换过滤条件会返回第一页。"
    },
    {
      "id": "othergroup",
      "text": "引用其他群的记忆时，需要说明事实来自其他群，必要时向用户确认。"
    }
  ],
