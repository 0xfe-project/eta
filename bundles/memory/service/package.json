{
  "name": "@axp/memory-service",
  "private": true,
  "scripts": {
    "build": "rm -rf out/models && FASTEMBED_CACHE_PATH=out/models uv run python -m axp_memory.embedding",
    "build:linux-amd64": "bash ../../../scripts/build/python.sh linux amd64",
    "build:linux-arm64": "bash ../../../scripts/build/python.sh linux arm64",
    "lint": "uv run ruff check .",
    "test": "bash ../../../scripts/test-postgres.sh && uv run pytest",
    "image:linux-amd64": "bash ../../../scripts/build/image.sh memory linux amd64",
    "image:linux-arm64": "bash ../../../scripts/build/image.sh memory linux arm64"
  }
}
