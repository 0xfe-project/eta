{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The embedding model, the same on every platform.
    "build": {
      "inputs": ["axp_memory/embedding.py", "uv.lock"],
      "outputs": ["out/models/**"]
    },
    // Dependencies only; the image copies the source itself.
    "build:linux-amd64": {
      "inputs": [
        "$TURBO_ROOT$/scripts/build/python.sh",
        "pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    },
    "build:linux-arm64": {
      "inputs": [
        "$TURBO_ROOT$/scripts/build/python.sh",
        "pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    },
    // The memory bundle's service: the model, the dependencies, the source.
    "image:linux-amd64": {
      "dependsOn": ["build", "build:linux-amd64"]
    },
    "image:linux-arm64": {
      "dependsOn": ["build", "build:linux-arm64"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/ruff.toml"]
    }
  }
}
