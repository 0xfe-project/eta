{
  "components": {
    "schemas": {
      "Bundle": {
        "additionalProperties": false,
        "properties": {
          "builtin": {
            "description": "Part of Eta, read only.",
            "type": "boolean"
          },
          "config": {
            "additionalProperties": {},
            "description": "What the user sets for it, a JSON Schema of string properties: environment variables of the agents that load it.",
            "type": "object"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "plugins": {
            "description": "Plugins it adds, by name (GET /api/v1/plugins).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required": {
            "description": "Built in and always loaded; cannot be disabled.",
            "type": "boolean"
          },
          "script": {
            "description": "Run as root when an agent's image is built, from the bundle's directory.",
            "type": "string"
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          },
          "service_status": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        },
        "required": [
          "required",
          "name",
          "description",
          "builtin",
          "script",
          "plugins"
        ],
        "type": "object"
      },
      "BundleConfigIn": {
        "additionalProperties": false,
        "properties": {
          "values": {
            "additionalProperties": {
              "type": ["string", "null"]
            },
            "description": "By property: a value sets it, null clears it; properties left out stay.",
            "type": "object"
          }
        },
        "required": ["values"],
        "type": "object"
      },
      "BundleCreateIn": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "name": {
            "description": "Lower-case letters, digits and hyphens.",
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "plugins": {
            "description": "Names from GET /api/v1/plugins.",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "script": {
            "description": "Run as root when an agent's image is built; a shell script unless it starts with #!.",
            "maxLength": 100000,
            "type": "string"
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          }
        },
        "required": ["name", "plugins"],
        "type": "object"
      },
      "BundleUpdateIn": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 500,
            "type": ["string", "null"]
          },
          "plugins": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": ["array", "null"]
          },
          "script": {
            "maxLength": 100000,
            "type": ["string", "null"]
          },
          "service": {
            "$ref": "#/components/schemas/Service",
            "description": "Its service; empty manifests remove it."
          }
        },
        "type": "object"
      },
      "ConfigState": {
        "additionalProperties": false,
        "properties": {
          "ready": {
            "description": "Every required property has a value, so agents get the bundle's plugins.",
            "type": "boolean"
          },
          "set": {
            "description": "Every property with a value, secrets included.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "values": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Values set, secrets left out.",
            "type": "object"
          }
        },
        "required": ["values", "set", "ready"],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": ["code", "message", "request_id"],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      },
      "Plugin": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["name", "description"],
        "type": "object"
      },
      "Service": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "description": "Give it a PostgreSQL database of its own (DATABASE_URL).",
            "type": "boolean"
          },
          "manifests": {
            "description": "Its Kubernetes objects, as YAML documents: a Service named after the bundle (port named http) and what serves it.",
            "maxLength": 200000,
            "type": "string"
          },
          "protocol": {
            "description": "What it speaks (name/major version), checked against its /.well-known/eta-service.",
            "maxLength": 100,
            "type": "string"
          },
          "uses": {
            "description": "What it may call through the runtime gateway with its token: llm, or other bundles by name.",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          }
        },
        "required": ["manifests"],
        "type": "object"
      },
      "ServiceStatus": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "state": {
            "description": "applying (not ready yet), ready, incompatible (speaks another protocol) or error.",
            "enum": ["applying", "ready", "incompatible", "error"],
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["state"],
        "type": "object"
      }
    }
  },
