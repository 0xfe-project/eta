    "/api/routines/v1/routines/{routine_id}/briefs/{version}/restore": {
      "post": {
        "operationId": "restoreBrief",
        "parameters": [
          {
            "description": "Retrying with the same key returns the first response instead of doing it again.",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "description": "Retrying with the same key returns the first response instead of doing it again.",
              "type": "string"
            }
          },
