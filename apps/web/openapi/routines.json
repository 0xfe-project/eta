{
  "components": {
    "schemas": {
      "Brief": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "feedback": {
            "description": "The feedback that revised it; null when the user wrote it.",
            "type": ["string", "null"]
          },
          "text": {
            "type": "string"
          },
          "version": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": ["version", "text", "created_at", "feedback"],
        "type": "object"
      },
      "CronSchedule": {
        "additionalProperties": false,
        "properties": {
          "cron": {
            "maxLength": 100,
            "type": "string"
          },
          "kind": {
            "enum": ["cron"],
            "type": "string"
          }
        },
        "required": ["kind", "cron"],
        "type": "object"
      },
      "DailySchedule": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["daily"],
            "type": "string"
          },
          "time": {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
          }
        },
        "required": ["kind", "time"],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": ["code", "message", "request_id"],
        "type": "object"
      },
      "Feedback": {
        "additionalProperties": false,
        "properties": {
          "brief_version": {
            "description": "The brief version it led to; null while the revision runs.",
            "format": "int32",
            "type": ["integer", "null"]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "revision_failed": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "created_at",
          "brief_version",
          "revision_failed"
        ],
        "type": "object"
      },
      "FeedbackIn": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["text"],
        "type": "object"
      },
      "Handoff": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "written_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["text", "written_at"],
        "type": ["object", "null"]
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      },
      "HourlySchedule": {
        "additionalProperties": false,
        "properties": {
          "every": {
            "enum": [1, 2, 3, 4, 6, 8, 12],
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "enum": ["hourly"],
            "type": "string"
          }
        },
        "required": ["kind", "every"],
        "type": "object"
      },
      "ListedRun": {
        "additionalProperties": false,
        "properties": {
          "finished_at": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "id": {
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": ["running", "sent", "nothing_new", "failed"],
            "type": "string"
          },
          "title": {
            "description": "The report's first heading, if it sent one.",
            "type": ["string", "null"]
          }
        },
        "required": ["id", "started_at", "finished_at", "status", "title"],
        "type": "object"
      },
      "Routine": {
        "additionalProperties": false,
        "properties": {
          "briefs": {
            "items": {
              "$ref": "#/components/schemas/Brief"
            },
            "type": "array"
          },
          "enabled": {
            "type": "boolean"
          },
          "handoff": {
            "$ref": "#/components/schemas/Handoff"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "next_run_at": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "type": "array"
          },
          "schedule": {
            "discriminator": {
              "mapping": {
                "cron": "#/components/schemas/CronSchedule",
                "daily": "#/components/schemas/DailySchedule",
                "hourly": "#/components/schemas/HourlySchedule",
                "weekly": "#/components/schemas/WeeklySchedule"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DailySchedule"
              },
              {
                "$ref": "#/components/schemas/WeeklySchedule"
              },
              {
                "$ref": "#/components/schemas/HourlySchedule"
              },
              {
                "$ref": "#/components/schemas/CronSchedule"
              }
            ]
          },
          "timezone": {
            "type": "string"
          },
          "group_id": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "model",
          "schedule",
          "timezone",
          "enabled",
          "next_run_at",
          "briefs",
          "handoff",
          "runs",
          "group_id"
        ],
        "type": "object"
      },
      "RoutineIn": {
        "additionalProperties": false,
        "properties": {
          "brief": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "schedule": {
            "discriminator": {
              "mapping": {
                "cron": "#/components/schemas/CronSchedule",
                "daily": "#/components/schemas/DailySchedule",
                "hourly": "#/components/schemas/HourlySchedule",
                "weekly": "#/components/schemas/WeeklySchedule"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DailySchedule"
              },
              {
                "$ref": "#/components/schemas/WeeklySchedule"
              },
              {
                "$ref": "#/components/schemas/HourlySchedule"
              },
              {
                "$ref": "#/components/schemas/CronSchedule"
              }
            ]
          },
          "timezone": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name", "brief", "model", "schedule", "timezone"],
        "type": "object"
      },
      "RoutineList": {
        "additionalProperties": false,
        "properties": {
          "routines": {
            "items": {
              "$ref": "#/components/schemas/RoutineSummary"
            },
            "type": "array"
          }
        },
        "required": ["routines"],
        "type": "object"
      },
      "RoutineSummary": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "next_run_at": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "revising": {
            "type": "boolean"
          },
          "runs": {
            "description": "The last runs, newest first.",
            "items": {
              "$ref": "#/components/schemas/ListedRun"
            },
            "type": "array"
          },
          "schedule": {
            "discriminator": {
              "mapping": {
                "cron": "#/components/schemas/CronSchedule",
                "daily": "#/components/schemas/DailySchedule",
                "hourly": "#/components/schemas/HourlySchedule",
                "weekly": "#/components/schemas/WeeklySchedule"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DailySchedule"
              },
              {
                "$ref": "#/components/schemas/WeeklySchedule"
              },
              {
                "$ref": "#/components/schemas/HourlySchedule"
              },
              {
                "$ref": "#/components/schemas/CronSchedule"
              }
            ]
          },
          "timezone": {
            "type": "string"
          },
          "unseen_failures": {
            "type": "integer",
            "format": "int64"
          },
          "unseen_reports": {
            "type": "integer",
            "format": "int64"
          },
          "group_id": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "model",
          "schedule",
          "timezone",
          "enabled",
          "next_run_at",
          "runs",
          "revising",
          "unseen_reports",
          "unseen_failures",
          "group_id",
          "revising",
          "unseen_reports",
          "unseen_failures"
        ],
        "type": "object"
      },
      "RoutineUpdateIn": {
        "additionalProperties": false,
        "properties": {
          "brief": {
            "maxLength": 8000,
            "minLength": 1,
            "type": ["string", "null"]
          },
          "enabled": {
            "type": ["boolean", "null"]
          },
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "type": ["string", "null"]
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": ["string", "null"]
          },
          "schedule": {
            "discriminator": {
              "mapping": {
                "cron": "#/components/schemas/CronSchedule",
                "daily": "#/components/schemas/DailySchedule",
                "hourly": "#/components/schemas/HourlySchedule",
                "weekly": "#/components/schemas/WeeklySchedule"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DailySchedule"
              },
              {
                "$ref": "#/components/schemas/WeeklySchedule"
              },
              {
                "$ref": "#/components/schemas/HourlySchedule"
              },
              {
                "$ref": "#/components/schemas/CronSchedule"
              }
            ]
          },
          "timezone": {
            "maxLength": 64,
            "minLength": 1,
            "type": ["string", "null"]
          }
        },
        "type": "object"
      },
      "Run": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": ["string", "null"]
          },
          "feedback": {
            "items": {
              "$ref": "#/components/schemas/Feedback"
            },
            "type": "array"
          },
          "finished_at": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "id": {
            "type": "string"
          },
          "report": {
            "type": ["string", "null"]
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": ["running", "sent", "nothing_new", "failed"],
            "type": "string"
          },
          "title": {
            "description": "The report's first heading, if it sent one.",
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "started_at",
          "finished_at",
          "status",
          "title",
          "report",
          "error",
          "feedback"
        ],
        "type": "object"
      },
      "WeeklySchedule": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "description": "0 is Sunday, as in cron.",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "maxItems": 7,
            "minItems": 1,
            "type": "array"
          },
          "kind": {
            "enum": ["weekly"],
            "type": "string"
          },
          "time": {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
          }
        },
        "required": ["kind", "days", "time"],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Eta Routines",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/routines/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API routines health",
        "tags": ["health"]
      }
    },
