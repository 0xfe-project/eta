{
  "name": "@axp/web",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "openapi-typescript --root-types --root-types-no-schema-prefix --default-non-nullable false",
    "dev": "vite",
    "build": "vite build && bun run bundle",
    "bundle": "rm -rf out && bun build server.js --target=bun --outdir out --define process.env.NODE_ENV='\"production\"' && mkdir -p out/dist && cp -r dist/client out/dist/",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "rstest run"
  },
  "dependencies": {
    "@blobatar/react": "^2.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@lexical/react": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@logtape/logtape": "^2.4.0",
    "@logtape/otel": "^2.4.0",
    "@opentelemetry/api-logs": "^0.208.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/cjk": "^1.0.4",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "blobatar": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.4",
    "lexical": "^0.52.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.16",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@rstest/core": "^0.12.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.13.0",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
