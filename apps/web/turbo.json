{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The control plane's types, from its OpenAPI document, which is
    // generated from its code.
    "generate": {
      "dependsOn": ["@axp/control-plane#openapi"],
      "outputs": ["src/api/control-plane.gen.ts"]
    },
    "lint": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "test": {
      "dependsOn": ["generate"]
    },
    "build": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.production"],
      "env": ["VITE_*"],
      // routeTree.gen.ts is generated by the build and needed by typecheck.
      "outputs": ["dist/**", "out/**", "src/routeTree.gen.ts"]
    }
  }
}
