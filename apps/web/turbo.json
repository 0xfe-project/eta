{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/eslint.config.js"]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!src/**/*.test.{ts,tsx}",
        "!src/**/test-*.{ts,tsx}",
        ".env",
        ".env.production"
      ],
      "env": ["VITE_*"],
      // routeTree.gen.ts is generated by Vite and needed by typecheck.
      "outputs": ["dist/**", "out/**", "src/routeTree.gen.ts"]
    }
  }
}
