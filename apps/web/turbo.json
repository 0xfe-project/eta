{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The types of the frozen OpenAPI snapshots (redocly.yaml lists them).
    // Nothing else produces them any more, so the task has no dependencies.
    "generate": {
      "inputs": ["openapi/**", "redocly.yaml"],
      "outputs": ["src/api/*.gen.ts"]
    },
    "lint": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "test": {
      "dependsOn": ["generate"]
    },
    "build": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.production"],
      "env": ["VITE_*"],
      // routeTree.gen.ts is generated by Vite and needed by typecheck.
      "outputs": ["dist/**", "out/**", "src/routeTree.gen.ts"]
    }
  }
}
