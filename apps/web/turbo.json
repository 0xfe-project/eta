{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The services' types, from their OpenAPI documents, which are
    // generated from their code (redocly.yaml lists them), and the
    // router's route tree from src/routes.
    "generate": {
      "dependsOn": ["@axp/control-plane#openapi"],
      "inputs": [
        "package.json",
        "redocly.yaml",
        "src/routes/**",
        {
          "mode": "dependencyOutputs",
          "globs": ["out/openapi.json", "out/routines.openapi.json"],
          "from": ["@axp/control-plane#openapi"]
        }
      ],
      "outputs": ["src/api/*.gen.ts", "src/routeTree.gen.ts"]
    },
    "typecheck": {
      "dependsOn": ["generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        {
          "mode": "dependencyOutputs",
          "globs": ["src/api/*.gen.ts", "src/routeTree.gen.ts"],
          "from": ["generate"]
        }
      ]
    },
    "lint": {
      "dependsOn": ["generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/eslint.config.js",
        {
          "mode": "dependencyOutputs",
          "globs": ["src/api/*.gen.ts", "src/routeTree.gen.ts"],
          "from": ["generate"]
        }
      ]
    },
    "test": {
      "dependsOn": ["generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.stories.tsx",
        "!.storybook/**",
        "!**/*.md",
        {
          "mode": "dependencyOutputs",
          "globs": ["src/api/*.gen.ts", "src/routeTree.gen.ts"],
          "from": ["generate"]
        }
      ]
    },
    "build": {
      "dependsOn": ["generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.stories.tsx",
        "!.storybook/**",
        "!**/*.md",
        ".env",
        ".env.production",
        {
          "mode": "dependencyOutputs",
          "globs": ["src/api/*.gen.ts", "src/routeTree.gen.ts"],
          "from": ["generate"]
        }
      ],
      "env": ["VITE_*"],
      "outputs": ["dist/**", "out/**", "src/routeTree.gen.ts"]
    }
  }
}
