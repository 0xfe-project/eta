{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The services' types, from their OpenAPI documents, which are
    // generated from their code (redocly.yaml lists them).
    "generate": {
      "dependsOn": ["@eta/app#openapi"],
      "outputs": ["src/api/*.gen.ts"]
    },
    "lint": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "test": {
      "dependsOn": ["generate"]
    },
    "build": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.production"],
      "env": ["VITE_*"],
      // routeTree.gen.ts is generated by Vite and needed by typecheck.
      "outputs": ["dist/**", "out/**", "src/routeTree.gen.ts"]
    }
  }
}
