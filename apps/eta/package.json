{
  "name": "@eta/app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The eta host: one Bun process that serves the web, the product database and the upstream WebSocket server.",
  "license": "MIT",
  "scripts": {
    "//": "Not `build`: turbo would run it on every check. One file with everything inside, as a release ships it.",
    "build:host": "bun scripts/build-host.ts",
    "dev": "bun --watch src/main.ts --allow-origin http://127.0.0.1:${ETA_WEB_PORT:-3000}",
    "email:demo": "bun scripts/email-demo.ts",
    "start": "bun src/main.ts",
    "typecheck": "bun check",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "test": "bun --bun vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@cpajs/codex-auth": "0.1.0-rc.8",
    "@cpajs/cpa": "0.1.0-rc.8",
    "@earendil-works/pi-ai": "0.85.1",
    "@eta/client-contracts": "*",
    "@eta/client-wire-proto": "*",
    "@eta/compaction": "*",
    "@eta/core": "*",
    "@eta/daemon": "*",
    "@eta/harness": "*",
    "@eta/mcp": "*",
    "@eta/releases": "*",
    "@eta/runtime-oar": "*",
    "@eta/server": "*",
    "@eta/ssh": "*",
    "@searxng-js/searxng": "0.1.0",
    "@searxng-js/sex-page": "0.1.1",
    "@searxng-js/sex-scrape": "0.1.1",
    "@searxng-js/sex-search": "0.1.1",
    "@searxng-js/sex-searxng": "0.1.1",
    "cheerio": "1.1.2",
    "croner": "10.0.1",
    "fflate": "^0.8.3",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "markdown-it": "15.0.3",
    "nodemailer": "10.2.1",
    "p-limit": "7.3.3",
    "sanitize-html": "2.18.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@botiverse/oar": "0.86.0",
    "@types/node": "22.19.19",
    "@types/sanitize-html": "2.16.2",
    "bun-types": "1.4.2",
    "imapkit": "5.2.0",
    "smtp-server": "3.21.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
