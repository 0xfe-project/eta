{
  "name": "@eta/app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The eta host: one Bun process that serves the web, the product database and the upstream WebSocket server.",
  "scripts": {
    "dev": "bun --watch src/main.ts --allow-origin http://127.0.0.1:${ETA_WEB_PORT:-3000} --github",
    "start": "bun src/main.ts",
    "typecheck": "bun check",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "test": "bun --bun vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@eta/client-contracts": "*",
    "@eta/client-wire-proto": "*",
    "@eta/compaction": "*",
    "@eta/core": "*",
    "@eta/daemon": "*",
    "@eta/execution-node": "*",
    "@eta/harness": "*",
    "@eta/llm-gateway": "*",
    "@eta/mcp": "*",
    "@eta/plugin-akhook": "*",
    "@eta/server": "*",
    "@eta/ssh": "*",
    "croner": "10.0.1",
    "fflate": "^0.8.3",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "bun-types": "1.4.2",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
