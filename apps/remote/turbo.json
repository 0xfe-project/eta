{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**",
        "$TURBO_ROOT$/scripts/build/remote.sh",
        "go.mod",
        "**/*.go",
        "!**/*_test.go"
      ],
      "outputs": ["out/**"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    }
  }
}
