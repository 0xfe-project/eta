{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  // Both tasks run nsh, and the release is pinned in this action: a pass from another build
  // of nsh is not a pass from this one, so a bump has to run them again.
  // ETA_NSH is named here because turbo hands a task only the variables it declares: without
  // this the override a developer sets is dropped and the run silently uses whatever nsh is
  // on PATH. Naming it also puts it in the hash, so a run with another binary misses the cache.
  "tasks": {
    "typecheck": {
      "env": ["ETA_NSH"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/.github/actions/setup-nsh/action.yml"
      ]
    },
    "test": {
      "env": ["ETA_NSH"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/.github/actions/setup-nsh/action.yml"
      ]
    }
  }
}
