{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:linux-amd64": {
      "inputs": [
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**",
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "!**/*_test.go"
      ]
    },
    "build:linux-arm64": {
      "inputs": [
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**",
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "!**/*_test.go"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    }
  }
}
