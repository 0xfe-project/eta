{
  "name": "@axp/routine-service",
  "private": true,
  "scripts": {
    "build:linux-amd64": "bash ../../scripts/build/go.sh axp-routines linux amd64",
    "build:linux-arm64": "bash ../../scripts/build/go.sh axp-routines linux arm64",
    "openapi": "mkdir -p out && go run . openapi > out/openapi.json",
    "lint": "test -z \"$(gofmt -l .)\" && go vet ./...",
    "test": "bash ../../scripts/dev-postgres.sh && go test ./..."
  }
}
