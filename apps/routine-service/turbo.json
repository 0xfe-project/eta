{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:linux-amd64": {
      "inputs": [
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/telemetry-go/**/*.go",
        "$TURBO_ROOT$/packages/telemetry-go/go.mod",
        "$TURBO_ROOT$/packages/telemetry-go/go.sum",
        "$TURBO_ROOT$/packages/plugins-go/**/*.go",
        "$TURBO_ROOT$/packages/plugins-go/go.mod",
        "$TURBO_ROOT$/packages/plugins-go/go.sum",
        "$TURBO_ROOT$/packages/service-go/**/*.go",
        "$TURBO_ROOT$/packages/service-go/**/*.sql",
        "$TURBO_ROOT$/packages/service-go/go.mod",
        "$TURBO_ROOT$/packages/service-go/go.sum",
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "**/*.sql",
        "!**/*_test.go"
      ]
    },
    "build:linux-arm64": {
      "inputs": [
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/telemetry-go/**/*.go",
        "$TURBO_ROOT$/packages/telemetry-go/go.mod",
        "$TURBO_ROOT$/packages/telemetry-go/go.sum",
        "$TURBO_ROOT$/packages/plugins-go/**/*.go",
        "$TURBO_ROOT$/packages/plugins-go/go.mod",
        "$TURBO_ROOT$/packages/plugins-go/go.sum",
        "$TURBO_ROOT$/packages/service-go/**/*.go",
        "$TURBO_ROOT$/packages/service-go/**/*.sql",
        "$TURBO_ROOT$/packages/service-go/go.mod",
        "$TURBO_ROOT$/packages/service-go/go.sum",
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "**/*.sql",
        "!**/*_test.go"
      ]
    },
    // The API's OpenAPI document, generated from the code; the web client's
    // types are generated from it (@axp/web#generate).
    "openapi": {
      "inputs": [
        "$TURBO_ROOT$/go.work",
        "go.mod",
        "go.sum",
        "**/*.go",
        "!**/*_test.go"
      ],
      "outputs": ["out/openapi.json"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/plugins-go/**",
        "$TURBO_ROOT$/packages/service-go/**"
      ]
    },
    // Tests run against development's PostgreSQL, in a database of their own;
    // AXP_TEST_NATS_URL adds the NATS test.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/plugins-go/**",
        "$TURBO_ROOT$/packages/service-go/**"
      ],
      "env": ["DATABASE_URL", "AXP_TEST_NATS_URL"]
    }
  }
}
