{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:linux-amd64": {
      "inputs": [
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**",
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "**/*.sql",
        "!**/*_test.go"
      ]
    },
    "build:linux-arm64": {
      "inputs": [
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**",
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "**/*.sql",
        "!**/*_test.go"
      ]
    },
    // The public API's OpenAPI document, generated from the code; the web
    // client's types are generated from it (@axp/web#generate).
    "openapi": {
      "inputs": [
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**",
        "go.mod",
        "go.sum",
        "**/*.go",
        "!**/*_test.go"
      ],
      "outputs": ["out/openapi.json"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    },
    // Tests run against development's PostgreSQL, each binary in a database
    // of its own; AXP_TEST_NATS_URL and AXP_TEST_DOCKER add the NATS and
    // Docker tests. CI fails without NATS (CI=1).
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**",
        "$TURBO_ROOT$/apps/agent-runtime/plugins/*/plugin.json",
        "$TURBO_ROOT$/apps/agent-runtime/plugins/*/mcp.json"
      ],
      "env": ["DATABASE_URL", "AXP_TEST_NATS_URL", "AXP_TEST_DOCKER", "CI"],
      "passThroughEnv": ["GOFLAGS"]
    }
  }
}
