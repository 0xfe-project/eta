{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "What a built-in bundle's config may be (docs/architecture/bundles.md#配置): a JSON Schema of string properties, each an environment variable the bundle's agents get, and nothing else.",
  "type": "object",
  "required": ["type", "properties", "additionalProperties"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "object" },
    "additionalProperties": { "const": false },
    "required": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
        "not": {
          "pattern": "^(AXP_|OTEL_|CODEX_|AKHOOK_|NODE_|LD_|(PATH|HOME|USER|SHELL|PWD|HOSTNAME|TERM|LANG)$)"
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "maxLength"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "writeOnly": { "type": "boolean" },
          "maxLength": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "minLength": { "type": "integer", "minimum": 0 },
          "pattern": { "type": "string" }
        }
      }
    }
  }
}
