DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional. Defaults to SQLite; the RFC targets PostgreSQL.
# DATABASE_URL=postgres://axp:axp@127.0.0.1:5432/axp

# Agent runtime (AXP_RUNTIME_MODE=docker bun run dev); see config/settings.py.
# OPENAI_API_KEY=sk-...                 # forwarded into runtime containers
# AXP_CODEX_AUTH_FILE=/path/to/auth.json  # alternative Codex credentials
# AXP_CODEX_LAUNCH=python -m axp_runtime.testing.fake_app_server  # no model
# AXP_CODEX_MODEL=
# AXP_CODEX_APPROVAL_POLICY=on-request
# AXP_WORKSPACE_BACKEND=volume          # or s3 with AXP_S3_* below
# AXP_S3_ENDPOINT=
# AXP_S3_ACCESS_KEY_ID=
# AXP_S3_SECRET_ACCESS_KEY=
# AXP_OBJECT_STORE=filesystem           # or s3 for checkpoints
