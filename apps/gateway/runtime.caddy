# Agent runtimes' and bundles' services' only route to AXP's services.
# Every route first asks the internal API who holds the key (an agent's, or
# a bundle's service's token) and passes the answer on as X-AXP-Agent-Id
# (and X-AXP-Bundle), replacing any value the caller sent; services behind
# this route trust those headers and hold no credentials of their own. A plugin's
# route also asks whether that agent's bundles add the plugin (403 if not),
# so removing a plugin takes its abilities away, not just its tools.
# Runtimes report to the control plane over NATS, never through here.

# Proxies to the upstream in the first argument as the runtime's agent.
(as_agent) {
	forward_auth {$AXP_UPSTREAM_INTERNAL:api:8001} {
		uri /internal/v1/runtime-auth
		copy_headers X-AXP-Agent-Id X-AXP-Group-Id
	}
	reverse_proxy {args[0]} {
		header_up -Authorization
		flush_interval -1
	}
}

# As as_agent, for an agent with the plugin in the second argument.
(as_agent_with) {
	forward_auth {$AXP_UPSTREAM_INTERNAL:api:8001} {
		uri /internal/v1/runtime-auth?plugin={args[1]}
		copy_headers X-AXP-Agent-Id X-AXP-Group-Id
	}
	reverse_proxy {args[0]} {
		header_up -Authorization
		flush_interval -1
	}
}

http://:{$AXP_RUNTIME_GATEWAY_PORT:8090} {
	bind {$AXP_RUNTIME_GATEWAY_BIND:0.0.0.0}
	import access_log

	# Only the internal API says these; X-AXP-Agent-Id is always replaced
	# with its answer (a bundle's service says which agent a model request
	# is for, runtime-auth decides).
	request_header -X-AXP-Group-Id
	request_header -X-AXP-Bundle

	# The models' OpenAI-compatible API, on the internal listener: Codex's
	# model provider, and bundles' services that use llm.
	handle /v1/* {
		forward_auth {$AXP_UPSTREAM_INTERNAL:api:8001} {
			uri /internal/v1/runtime-auth?use=llm
			copy_headers X-AXP-Agent-Id X-AXP-Bundle
		}
		reverse_proxy {$AXP_UPSTREAM_INTERNAL:api:8001} {
			header_up -Authorization
			flush_interval -1
		}
	}
	# Bundles' services (docs/architecture/bundles.md#服务): /bundles/<name>/x
	# is /<name>/x at the Service <name>, for agents that load the bundle
	# and services that use it.
	@bundle path_regexp ^/bundles/[a-z0-9][a-z0-9-]*/
	handle @bundle {
		uri strip_prefix /bundles
		forward_auth {$AXP_UPSTREAM_INTERNAL:api:8001} {
			uri /internal/v1/runtime-auth?bundle={http.request.uri.path.0}
			copy_headers X-AXP-Agent-Id X-AXP-Group-Id X-AXP-Bundle
		}
		request_header -Authorization
		import bundle_service {http.request.uri.path.0}
	}
	handle /groups/* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:api:8001} groups
	}
	# The task board: the tasks plugin's MCP server, in the internal API.
	handle /tasks/* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:api:8001} tasks
	}
	# Remote runtimes' native methods: the agenvo plugin's MCP server, the
	# relay's tools forwarded with the control plane's grant.
	handle /agenvo/* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:api:8001} agenvo
	}
	# Artifacts: the artifacts plugin's upload, in the internal API.
	handle /artifacts/* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:api:8001} artifacts
	}
	# The files the user attached to messages to this agent, which the
	# runtime fetches before handing a turn to Codex.
	handle /attachments/* {
		import as_agent {$AXP_UPSTREAM_INTERNAL:api:8001}
	}
	# Routines: the routines plugin's MCP server, in the internal API.
	handle /routines/* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:api:8001} routines
	}
	# Code hosting: the github plugin's MCP server (open_pull_request)...
	handle /forge/mcp* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:api:8001} github
	}
	# ...and git's and gh's GitHub credentials, which every runtime fetches.
	handle /forge/* {
		import as_agent {$AXP_UPSTREAM_INTERNAL:api:8001}
	}
	respond 404

	import errors
}
