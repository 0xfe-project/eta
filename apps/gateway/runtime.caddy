# Agent runtimes' only route out. The internal API authenticates runtimes
# itself (it issues their tokens and fences replaced instances). Everything
# else first asks it who holds the runtime key and passes the answer on as
# X-AXP-Agent-Id, replacing any value the runtime sent; services behind this
# route trust that header and hold no credentials of their own.

# Proxies to the upstream in the first argument as the runtime's agent.
(as_agent) {
	forward_auth {$AXP_UPSTREAM_INTERNAL:axp-internal:8001} {
		uri /internal/v1/runtime-auth
		copy_headers X-AXP-Agent-Id
	}
	reverse_proxy {args[0]} {
		header_up -Authorization
		flush_interval -1
	}
}

http://:{$AXP_RUNTIME_GATEWAY_PORT:8090} {
	bind {$AXP_RUNTIME_GATEWAY_BIND:0.0.0.0}
	import access_log

	handle /internal/* {
		reverse_proxy {$AXP_UPSTREAM_INTERNAL:axp-internal:8001}
	}
	# The LLM gateway's OpenAI-compatible API: Codex's model provider.
	handle /v1/* {
		import as_agent {$AXP_UPSTREAM_LLM:axp-llm:8317}
	}
	# Agents' memories: the memory plugin's MCP server and hooks.
	handle /memory/* {
		import as_agent {$AXP_UPSTREAM_MEMORY:axp-memory:8320}
	}
	# The task board: the tasks plugin's MCP server, in the internal API.
	handle /tasks/* {
		import as_agent {$AXP_UPSTREAM_INTERNAL:axp-internal:8001}
	}
	# Code hosting: git's and gh's GitHub credentials, open_pull_request.
	handle /forge/* {
		import as_agent {$AXP_UPSTREAM_FORGE:axp-forge:8330}
	}
	respond 404

	import errors
}
