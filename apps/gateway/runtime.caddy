# Agent runtimes' only route out. The internal API authenticates runtimes
# itself (it issues their tokens and fences replaced instances). Everything
# else first asks it who holds the runtime key and passes the answer on as
# X-AXP-Agent-Id, replacing any value the runtime sent; services behind this
# route trust that header and hold no credentials of their own. A plugin's
# route also asks whether that agent has the plugin enabled (403 if not), so
# turning a plugin off takes its abilities away, not just its tools.

# Proxies to the upstream in the first argument as the runtime's agent.
(as_agent) {
	forward_auth {$AXP_UPSTREAM_INTERNAL:axp-internal:8001} {
		uri /internal/v1/runtime-auth
		copy_headers X-AXP-Agent-Id
	}
	reverse_proxy {args[0]} {
		header_up -Authorization
		flush_interval -1
	}
}

# As as_agent, for an agent with the plugin in the second argument.
(as_agent_with) {
	forward_auth {$AXP_UPSTREAM_INTERNAL:axp-internal:8001} {
		uri /internal/v1/runtime-auth?plugin={args[1]}
		copy_headers X-AXP-Agent-Id
	}
	reverse_proxy {args[0]} {
		header_up -Authorization
		flush_interval -1
	}
}

http://:{$AXP_RUNTIME_GATEWAY_PORT:8090} {
	bind {$AXP_RUNTIME_GATEWAY_BIND:0.0.0.0}
	import access_log

	handle /internal/* {
		reverse_proxy {$AXP_UPSTREAM_INTERNAL:axp-internal:8001}
	}
	# The LLM gateway's OpenAI-compatible API: Codex's model provider.
	handle /v1/* {
		import as_agent {$AXP_UPSTREAM_LLM:axp-llm:8317}
	}
	# Agents' memories: the memory plugin's MCP server and hooks.
	handle /memory/* {
		import as_agent_with {$AXP_UPSTREAM_MEMORY:axp-memory:8320} memory
	}
	# The task board: the tasks plugin's MCP server, in the internal API.
	handle /tasks/* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:axp-internal:8001} tasks
	}
	# Remote runtimes' native methods: the agenvo plugin's MCP server, the
	# relay's tools forwarded with the control plane's grant.
	handle /agenvo/* {
		import as_agent_with {$AXP_UPSTREAM_INTERNAL:axp-internal:8001} agenvo
	}
	# Routines: the routines plugin's MCP server, in the routine service.
	handle /routines/* {
		import as_agent_with {$AXP_UPSTREAM_ROUTINES:axp-routines:8340} routines
	}
	# Code hosting: the github plugin's MCP server (open_pull_request)...
	handle /forge/mcp* {
		import as_agent_with {$AXP_UPSTREAM_FORGE:axp-forge:8330} github
	}
	# ...and git's and gh's GitHub credentials, which every runtime fetches.
	handle /forge/* {
		import as_agent {$AXP_UPSTREAM_FORGE:axp-forge:8330}
	}
	respond 404

	import errors
}
