# AXP's gateways (Caddy). Two sites, each its own Kamal role in production:
#
#   public.caddy   the browser's single same-origin entry
#   runtime.caddy  agent runtimes' only route to the control plane's internal
#                  API (with code hosting, routines and the LLM gateway's
#                  /v1) and the memory service; it authenticates each runtime
#                  once for them
#
# Upstreams trust the network instead of a shared secret: only the public
# gateway reaches web, the control plane's public listener, OpenObserve and
# the memory service's /api, only the runtime gateway (and AXP's own
# services) the control plane's internal listener, and runtimes (on their
# own network) reach only the runtime gateway, S3, NATS and the
# OpenTelemetry Collector. AXP_GATEWAY_SITES picks the sites to serve; every
# address defaults to production's and scripts/dev.sh overrides them.
{
	admin off
	auto_https off
	persist_config off
}

# One JSON line per request, without the headers.
(access_log) {
	log {
		format filter {
			request>headers delete
			resp_headers delete
		}
	}
}

# Failures use the control plane's error envelope. An unreachable upstream is
# 503, not 502: Cloudflare replaces an origin's 502 and 504 with its own page.
(errors) {
	handle_errors {
		header Content-Type application/json
		@too_large expression {err.status_code} == 413
		respond @too_large `{"error":{"code":"PAYLOAD_TOO_LARGE","message":"请求内容过大。","request_id":"{http.request.uuid}"}}` 413
		@forbidden expression {err.status_code} == 403
		respond @forbidden `{"error":{"code":"CROSS_SITE_FORBIDDEN","message":"不接受来自其他站点的请求。","request_id":"{http.request.uuid}"}}` 403
		respond `{"error":{"code":"UPSTREAM_UNAVAILABLE","message":"服务暂时不可用，请稍后再试。","request_id":"{http.request.uuid}"}}` 503
	}
}

import {$AXP_GATEWAY_SITES:*.caddy}
