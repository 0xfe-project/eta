# AXP's gateways (Caddy): one process serving two sites, the task gateway
# of the job axp in production (deploy/nomad/axp.nomad.hcl) and the job
# gateway in development (scripts/dev-gateway.nomad.hcl):
#
#   public.caddy   the browser's single same-origin entry
#   runtime.caddy  agent runtimes' and bundles' services' only route to the
#                  control plane's internal API (with code hosting, routines
#                  and the models) and to bundles' services; it
#                  authenticates each caller once for them
#
# AXP's processes listen on the host's network: the browser's gateway on
# loopback (the host's Caddy proxies to it), the runtime gateway where
# Nomad's bridge network reaches it. Every address defaults to production's
# and scripts/dev.sh overrides them; development adds its HTTPS site.
{
	admin off
	auto_https off
	persist_config off
}

# One JSON line per request, without the headers.
(access_log) {
	log {
		format filter {
			request>headers delete
			resp_headers delete
		}
	}
}

# Bundles' services, found through Nomad's service discovery: the gateway's
# task renders bundles.caddy from the services in AXP's namespace (the
# template in its job) and Caddy reloads it (SIGUSR1) when they change. It
# maps the bundle named by the route's `bundle` matcher to its address
# ({bundle_upstream}) and names the agenvo relay's ({vars.relay_upstream}).
# A glob, so the configuration also loads before it is rendered (and in
# `bun run lint`): then no bundle has an address.
(bundles) {
	import /local/bundles*.caddy
}

(bundle_service) {
	reverse_proxy {bundle_upstream} {
		flush_interval -1
	}
}

# Sentry's envelopes (errors, logs, transactions) for the project in the
# path, at Rustrak (deploy/nomad/infra.nomad.hcl), from the browser and
# bundles' services: their DSN is a gateway's /sentry. Nothing else of
# Rustrak's (its dashboard, its API) is reachable through a gateway.
(sentry) {
	@sentry path_regexp ^/sentry/api/[0-9]+/envelope/$
	handle @sentry {
		log_skip
		uri strip_prefix /sentry
		reverse_proxy {$AXP_UPSTREAM_SENTRY:127.0.0.1:24080}
	}
}

# Failures use the control plane's error envelope. An unreachable upstream is
# 503, not 502: Cloudflare replaces an origin's 502 and 504 with its own page.
(errors) {
	handle_errors {
		header Content-Type application/json
		@too_large expression {err.status_code} == 413
		respond @too_large `{"error":{"code":"PAYLOAD_TOO_LARGE","message":"请求内容过大。","request_id":"{http.request.uuid}"}}` 413
		@forbidden expression {err.status_code} == 403
		respond @forbidden `{"error":{"code":"CROSS_SITE_FORBIDDEN","message":"不接受来自其他站点的请求。","request_id":"{http.request.uuid}"}}` 403
		respond `{"error":{"code":"UPSTREAM_UNAVAILABLE","message":"服务暂时不可用，请稍后再试。","request_id":"{http.request.uuid}"}}` 503
	}
}

import *.caddy
