# AXP's gateways (Caddy). Two sites, each a Deployment in production
# (deploy/k3s/app/gateways.yaml):
#
#   public.caddy   the browser's single same-origin entry
#   runtime.caddy  agent runtimes' and bundles' services' only route to the
#                  control plane's internal API (with code hosting, routines
#                  and the models) and to bundles' services; it
#                  authenticates each caller once for them
#
# Upstreams trust the network instead of a shared secret (NetworkPolicy,
# deploy/k3s): only the public gateway reaches web and the control plane's
# public listener, only the runtime gateway the control plane's internal
# listener for runtimes and services, which reach nothing else of AXP's but
# NATS and the OpenTelemetry Collector. AXP_GATEWAY_SITES picks the sites to
# serve; every address defaults to production's and scripts/dev.sh
# overrides them.
{
	admin off
	auto_https off
	persist_config off
}

# One JSON line per request, without the headers.
(access_log) {
	log {
		format filter {
			request>headers delete
			resp_headers delete
		}
	}
}

# The bundle's service named in the first argument (a path segment): the
# Service <name> (port 80) in the bundles' namespace, found through the
# cluster's DNS (development's gateway runs outside the cluster).
(bundle_service) {
	reverse_proxy {args[0]}.{$AXP_BUNDLES_NAMESPACE:axp-bundles}.svc.cluster.local:80 {
		flush_interval -1
		transport http {
			resolvers {$AXP_CLUSTER_DNS:10.43.0.10}
		}
	}
}

# Failures use the control plane's error envelope. An unreachable upstream is
# 503, not 502: Cloudflare replaces an origin's 502 and 504 with its own page.
(errors) {
	handle_errors {
		header Content-Type application/json
		@too_large expression {err.status_code} == 413
		respond @too_large `{"error":{"code":"PAYLOAD_TOO_LARGE","message":"请求内容过大。","request_id":"{http.request.uuid}"}}` 413
		@forbidden expression {err.status_code} == 403
		respond @forbidden `{"error":{"code":"CROSS_SITE_FORBIDDEN","message":"不接受来自其他站点的请求。","request_id":"{http.request.uuid}"}}` 403
		respond `{"error":{"code":"UPSTREAM_UNAVAILABLE","message":"服务暂时不可用，请稍后再试。","request_id":"{http.request.uuid}"}}` 503
	}
}

import {$AXP_GATEWAY_SITES:*.caddy}
