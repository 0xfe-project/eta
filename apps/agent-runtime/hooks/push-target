#!/usr/bin/env python3
"""akhook `decide` script: does a `git push` reach a protected branch?

akhook runs this once a command contains `git push`, with the candidate on
stdin ({"candidate": {"type": "shell_exec", "command": ...}}) in the
command's working directory. It answers {"action": "ask", "message": ...}
when a push would update or delete the default branch, main or master, and
{"action": "allow"} otherwise. Nothing here touches the network: the targets
come from the command and the repository's own configuration, as git would
compute them.
"""

import json
import os
import shlex
import subprocess
import sys

PROTECTED = {"main", "master"}
# Separators between simple commands, as shlex.split leaves them.
SEPARATORS = {"&&", "||", ";", "|", "&"}
# `git push` options that take a separate value.
VALUED = {"--repo", "-o", "--push-option", "--receive-pack", "--exec"}
# Options that push branches the command does not name.
EVERYTHING = {"--all", "--branches", "--mirror"}


def git(cwd: str, *args: str) -> str | None:
    try:
        done = subprocess.run(
            ["git", "-C", cwd, *args], capture_output=True, text=True, timeout=5
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def segments(command: str) -> list[list[str]]:
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|")
    lexer.whitespace_split = True
    words, current = [], []
    for token in lexer:
        if token in SEPARATORS:
            words.append(current)
            current = []
        else:
            current.append(token)
    words.append(current)
    return [w for w in words if w]


def pushes(command: str, cwd: str):
    """(cwd, push arguments) of each `git push`, following `cd` and `-C`."""
    for words in segments(command):
        while words and "=" in words[0] and not words[0].startswith("-"):
            words = words[1:]  # FOO=bar git push
        if not words:
            continue
        if words[0] == "cd" and len(words) > 1:
            cwd = os.path.join(cwd, os.path.expanduser(words[1]))
            continue
        if os.path.basename(words[0]) != "git":
            continue
        args, here = words[1:], cwd
        while args and args[0].startswith("-"):
            option = args.pop(0)
            if option in ("-C", "-c", "--git-dir", "--work-tree") and args:
                value = args.pop(0)
                if option == "-C":
                    here = os.path.join(here, value)
        if args and args[0] == "push":
            yield here, args[1:]


def short(ref: str) -> str | None:
    """The branch a destination ref names, if it names one."""
    if ref.startswith("refs/heads/"):
        return ref[len("refs/heads/") :]
    if ref.startswith("refs/"):
        return None  # tags, notes and the like
    return ref


def targets(cwd: str, args: list[str]) -> tuple[set[str], str | None]:
    """Branches this push updates or deletes, and the remote it goes to."""
    positional, everything = [], False
    rest = iter(args)
    for arg in rest:
        if arg in VALUED:
            next(rest, None)
        elif arg in EVERYTHING:
            everything = True
        elif arg == "--":
            positional.extend(rest)
        elif not arg.startswith("-"):
            positional.append(arg)
    current = git(cwd, "symbolic-ref", "--short", "-q", "HEAD")
    remote = positional[0] if positional else None
    if remote is None and current:
        remote = (
            git(cwd, "config", f"branch.{current}.pushRemote")
            or git(cwd, "config", "remote.pushDefault")
            or git(cwd, "config", f"branch.{current}.remote")
        )
    if everything:
        return {"*"}, remote
    refspecs = positional[1:]
    if not refspecs:
        if git(cwd, "config", "push.default") == "matching":
            return {"*"}, remote
        # Where a bare `git push` sends the current branch, by git's rules.
        dest = git(cwd, "rev-parse", "--symbolic-full-name", "@{push}")
        if dest and dest.startswith("refs/remotes/"):
            return {dest.split("/", 3)[3]}, remote
        return ({current} if current else set()), remote
    branches = set()
    for spec in refspecs:
        spec = spec.lstrip("+")
        source, _, dest = spec.partition(":")
        name = dest or source
        if name == "HEAD":
            name = current or ""
        if name:
            branch = short(name)
            if branch:
                branches.add(branch)
    return branches, remote


def default_branch(cwd: str, remote: str | None) -> str | None:
    head = git(cwd, "symbolic-ref", "--short", "-q", f"refs/remotes/{remote or 'origin'}/HEAD")
    return head.split("/", 1)[1] if head and "/" in head else None


def decide(command: str, cwd: str) -> dict:
    hit = []
    for here, args in pushes(command, cwd):
        branches, remote = targets(here, args)
        protected = set(PROTECTED)
        if default := default_branch(here, remote):
            protected.add(default)
        if "*" in branches:
            hit.append("所有分支")
        hit.extend(sorted(branches & protected))
    if not hit:
        return {"action": "allow"}
    names = "、".join(dict.fromkeys(hit))
    return {"action": "ask", "message": f"要推送到受保护分支：{names}。"}


def main() -> None:
    candidate = json.load(sys.stdin).get("candidate") or {}
    command = candidate.get("command") or ""
    try:
        answer = decide(command, os.getcwd())
    except Exception as exc:  # unreadable command: ask rather than guess
        answer = {"action": "ask", "message": f"无法判断这次推送的目标（{exc}）。"}
    json.dump(answer, sys.stdout, ensure_ascii=False)


if __name__ == "__main__":
    main()
