{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // One bundle for every platform (Node); the image copies it.
    "build": {
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": ["out/**"]
    },
    // The base image: the runtime's bundle, akhook and axp-plugins, which
    // compiles each agent's plugins when the control plane builds its image.
    "image:linux-amd64": {
      "dependsOn": ["build", "@axp/plugins-go#build:linux-amd64"]
    },
    "image:linux-arm64": {
      "dependsOn": ["build", "@axp/plugins-go#build:linux-arm64"]
    },
    // The image's rules run with akhook; in CI (CI set) they never skip.
    "test": {
      "dependsOn": ["@axp/akhook#build"],
      "env": ["CI"]
    }
  }
}
