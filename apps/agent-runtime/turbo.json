{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The app-server protocol's types, from the Codex package.json pins.
    "generate": {
      "inputs": ["package.json"],
      "outputs": ["src/protocol/**"]
    },
    // One bundle for every platform (Node); the image copies it.
    "build": {
      "dependsOn": ["generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/*.test.ts",
        "!codex/**",
        "!**/*.md"
      ],
      "outputs": ["out/**"]
    },
    "typecheck": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", "!codex/**", "!**/*.md"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!codex/**",
        "!**/*.md",
        "$TURBO_ROOT$/eslint.config.js"
      ]
    },
    // The base image: the runtime's bundle, akhook and axp-plugins, which
    // compiles each agent's plugins when the control plane builds its image.
    "image:linux-amd64": {
      "dependsOn": ["build", "@axp/plugins-go#build:linux-amd64"]
    },
    "image:linux-arm64": {
      "dependsOn": ["build", "@axp/plugins-go#build:linux-arm64"]
    },
    // The image's rules run with akhook; in CI (CI set) they never skip.
    "test": {
      "dependsOn": ["generate", "@axp/akhook#build"],
      // The plugins' hooks and servers are tested here too.
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/plugins/**"],
      "env": ["CI"]
    }
  }
}
