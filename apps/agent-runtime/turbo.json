{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // Dependencies only; the image copies the source itself.
    "build:linux-amd64": {
      "inputs": [
        "$TURBO_ROOT$/scripts/build/python.sh",
        "pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    },
    "build:linux-arm64": {
      "inputs": [
        "$TURBO_ROOT$/scripts/build/python.sh",
        "pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    }
  }
}
