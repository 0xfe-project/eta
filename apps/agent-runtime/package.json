{
  "name": "@axp/agent-runtime",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rm -rf out && bun build src/main.ts --target=node --outfile out/main.js",
    "image:linux-amd64": "bash ../../scripts/build/image.sh runtime linux amd64",
    "image:linux-arm64": "bash ../../scripts/build/image.sh runtime linux arm64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "generate": "rm -rf src/protocol && codex app-server generate-ts --out src/protocol"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@openai/codex": "0.162.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
