# Ports reserved for production on every machine. deploy/deploy.sh always uses
# them (production.env cannot override) and scripts/dev.sh refuses them. They
# are outside dev's 3000-3992 range, the Linux ephemeral range (32768+), and
# the well-known ports of common services.
AXP_PROD_HTTP_PORT=24180
AXP_PROD_HTTPS_PORT=24143
AXP_PROD_REGISTRY_PORT=24150
