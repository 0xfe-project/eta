# Only the prebuilt artifacts, the memory service's sources, the runtime's
# plugins, the gateway configuration and what remote computers download are
# sent to Docker.
*
!apps/control-plane/out/
!apps/llm-gateway/out/
!apps/forge-service/out/
!apps/routine-service/out/
!packages/plugins-go/out/
!apps/gateway/Caddyfile
!apps/gateway/*.caddy
!apps/web/out/
!apps/memory-service/out/
!apps/memory-service/axp_memory/
!apps/agent-runtime/plugins/
!apps/remote/out/dist/
!apps/relay/out/connectors/
**/__pycache__
**/*.py[cod]
