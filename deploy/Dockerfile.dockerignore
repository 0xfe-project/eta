# Only the prebuilt artifacts, the control plane and memory service sources,
# the runtime's plugins and the gateway configuration are sent to Docker.
*
!apps/control-plane/out/
!apps/llm-gateway/out/
!apps/forge-service/out/
!apps/gateway/Caddyfile
!apps/gateway/*.caddy
!apps/web/out/
!apps/control-plane/manage.py
!apps/control-plane/gunicorn.conf.py
!apps/control-plane/config/
!apps/control-plane/chat/
!apps/control-plane/routines/
!apps/memory-service/out/
!apps/memory-service/axp_memory/
!apps/agent-runtime/plugins/
**/__pycache__
**/*.py[cod]
