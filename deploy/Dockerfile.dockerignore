# Only the prebuilt artifacts, the bundles and plugins agents are built
# from, the gateway configuration and what remote computers download are
# sent to BuildKit.
*
!apps/control-plane/out/
!packages/plugins-go/out/
!apps/gateway/Caddyfile
!apps/gateway/*.caddy
!apps/web/out/
!bundles/
!plugins/
# Bundles' services run from images of their own; only their manifests.
bundles/*/service/*
!bundles/*/service/*.yaml
!apps/remote/out/dist/
!apps/agenvo/out/dist/
**/__pycache__
**/*.py[cod]
