# Kamal reads these from the environment; deploy/deploy.sh loads them from
# ~/.config/axp/production.env (generated on first deploy, never committed).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
AXP_SECRET_KEY=$AXP_SECRET_KEY
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgres://axp:$POSTGRES_PASSWORD@axp-postgres:5432/axp
ZO_ROOT_USER_PASSWORD=$AXP_OBSERVE_PASSWORD
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20$AXP_OBSERVE_BASIC
OPENOBSERVE_AUTHORIZATION="Basic $AXP_OBSERVE_BASIC"
# The agenvo relay's administrator secret: the relay's, and the control
# plane's to manage it.
AGENVO_ADMIN_SECRET=$AXP_RELAY_ADMIN_SECRET
AXP_RELAY_ADMIN_SECRET=$AXP_RELAY_ADMIN_SECRET
