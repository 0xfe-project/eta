{
  "name": "eta",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "setup": "bun install && uv sync --project apps/memory --dev",
    "dev": "bun scripts/dev.ts",
    "dev:client": "bun scripts/dev.ts",
    "client:package": "bun run --cwd apps/client package",
    "client:update-manifest": "bun scripts/nsh-client.ts update-manifest",
    "client:publish:ios": "bun run --cwd apps/client publish:ios",
    "client:publish:android": "bun run --cwd apps/client publish:android",
    "host:install": "bun scripts/host-install.ts",
    "build": "turbo run build",
    "check": "bun --bun dprint check && turbo run build typecheck lint //#lint:repo test //#knip",
    "check:affected": "bun --bun dprint check && turbo run build typecheck lint //#lint:repo test //#knip --affected",
    "test": "turbo run test",
    "test:scripts": "bun --bun vitest --run scripts/host-launcher",
    "lint": "turbo run lint //#lint:repo",
    "format": "bun --bun dprint fmt",
    "knip": "knip",
    "lint:repo": "eslint --cache --cache-location node_modules/.cache/eslint/repo . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'"
  },
  "trustedDependencies": ["@ast-grep/cli"],
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@resvg/resvg-wasm": "^2.6.2",
    "dprint": "^0.60.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
