{
	"name": "@eta/server",
	"version": "0.1.0",
	"description": "The eta server: many sessions in one process, each one a harness session behind a store.",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"scripts": {
		"test": "vitest --run --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"dependencies": {
		"@eta/core": "*",
		"@eta/harness": "*"
	}
}
