{
	"name": "@eta/server",
	"version": "0.1.0",
	"description": "The eta server: many sessions in one process, each one a harness session behind a store.",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"scripts": {
		"test": "vitest --run --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"smoke": "ETA_SMOKE_CONFIG=\"${ETA_SMOKE_CONFIG:-$HOME/.eta/config.json}\" vitest --run test/session.e2e.test.ts test/server-smoke.test.ts"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9",
		"bun-types": "1.4.2",
		"@eta/execution-node": "*",
		"@eta/ssh": "*"
	},
	"dependencies": {
		"@eta/core": "*",
		"@eta/harness": "*",
		"@eta/storage-jsonl": "*",
		"@eta/client-wire-proto": "*",
		"@earendil-works/pi-ai": "0.85.1",
		"cordis": "^4.0.0-rc.10"
	}
}
