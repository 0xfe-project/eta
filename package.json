{
	"name": "@eta/core",
	"version": "0.1.0",
	"description": "Eta kernel: cordis bus, three privileged primitives (goal/persona/tasks), the runner, and the type surface.",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"scripts": {
		"test": "vitest --run --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"smoke": "ETA_SMOKE_CONFIG=\"${ETA_SMOKE_CONFIG:-$HOME/.eta/config.json}\" vitest --run test/smoke.e2e.test.ts"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9",
		"@eta/compaction": "*"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"cordis": "^4.0.0-rc.10"
	}
}
