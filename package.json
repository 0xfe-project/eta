{
  "name": "eta",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "setup": "bun install && uv sync --project apps/memory --dev",
    "dev": "bun scripts/dev.ts",
    "host:install": "bun scripts/host-install.ts",
    "build": "turbo run build",
    "check": "dprint check && turbo run build typecheck lint //#lint:repo test //#test:install //#typecheck:install //#knip",
    "check:affected": "dprint check && turbo run build typecheck lint //#lint:repo test //#test:install //#typecheck:install //#knip --affected",
    "test": "turbo run test //#test:install",
    "test:install": "bun test scripts/install",
    "test:install:platform": "bun scripts/install/platform-key.ts",
    "typecheck:install": "tsc -p scripts/install",
    "lint": "turbo run lint //#lint:repo",
    "format": "dprint fmt",
    "knip": "knip",
    "lint:repo": "eslint --cache --cache-location node_modules/.cache/eslint/repo . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@types/node": "22.19.19",
    "bun-types": "1.4.2",
    "dprint": "^0.60.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  }
}
