{
  "name": "eta",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n host,web -c cyan,magenta \"bun run dev:host\" \"bun run dev:web\"",
    "dev:host": "bun apps/eta/src/main.ts --host 127.0.0.1 --port 8787",
    "dev:web": "bun run --cwd apps/web dev",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "turbo run lint && bun run lint:repo",
    "lint:repo": "eslint . --ignore-pattern 'apps/web/**'",
    "knip": "knip",
    "test": "turbo run test",
    "check": "bun run --cwd apps/eta smoke:ci && dprint check && bun run lint:repo && turbo run typecheck lint test knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.24.8",
    "concurrently": "^9.2.1",
    "dprint": "^0.60.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "lefthook": "^2.1.17",
    "turbo": "^2.11.7",
    "typescript": "5.9.3"
  }
}
