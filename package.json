{
	"name": "@eta/harness",
	"version": "0.1.0",
	"description": "The default minimal runnable set for eta: journaling, compaction, metrics, task reminders, the run pump, and the session assembler.",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts",
		"./env": "./src/env/types.ts"
	},
	"scripts": {
		"test": "vitest --run --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"smoke": "ETA_SMOKE_CONFIG=\"${ETA_SMOKE_CONFIG:-$HOME/.eta/config.json}\" vitest --run test/smoke.e2e.test.ts test/smoke-compaction.e2e.test.ts test/session.e2e.test.ts"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@eta/compaction": "*",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@eta/core": "*",
		"cordis": "^4.0.0-rc.10",
		"diff": "^9.0.0",
		"ignore": "^7.0.10",
		"typebox": "^1.3.34",
		"yaml": "^2.9.1"
	}
}
