{
  "name": "eta",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "setup": "bun install && uv sync --project apps/memory --dev",
    "dev": "bun scripts/dev.ts",
    "dev:client": "bun scripts/dev.ts",
    "client:package": "bun run --cwd apps/client package",
    "client:update-manifest": "bun scripts/nsh-client.ts update-manifest",
    "client:publish:ios": "bun run --cwd apps/client publish:ios",
    "client:publish:android": "bun run --cwd apps/client publish:android",
    "host:install": "bun scripts/host-install.ts",
    "build": "turbo run build",
    "check": "xmas scripts/format.ts --check && turbo run build typecheck lint //#lint:repo test //#knip",
    "check:affected": "xmas scripts/format.ts --check && turbo run build typecheck lint //#lint:repo test //#knip --affected",
    "test": "turbo run test",
    "test:scripts": "bun --bun vitest --run scripts/host-launcher",
    "lint": "xmas scripts/lint.ts",
    "format": "xmas scripts/format.ts",
    "knip": "knip",
    "lint:repo": "xmas scripts/lint.ts .",
    "lint:fix": "xmas scripts/lint.ts --fix",
    "format:check": "xmas scripts/format.ts --check"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
