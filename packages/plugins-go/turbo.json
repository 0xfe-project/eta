{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // axp-plugins, which the images run while they are built.
    "build:linux-amd64": {
      "inputs": [
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "!**/*_test.go"
      ]
    },
    "build:linux-arm64": {
      "inputs": [
        "$TURBO_ROOT$/scripts/build/go.sh",
        "go.mod",
        "go.sum",
        "**/*.go",
        "!**/*_test.go"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    // The tests compile the repository's plugins and run their hooks with
    // akhook; in CI (CI set) they never skip those.
    "test": {
      "dependsOn": ["@axp/akhook#build"],
      "env": ["CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/plugins/**",
        "$TURBO_ROOT$/apps/agent-runtime/codex/**"
      ]
    }
  }
}
