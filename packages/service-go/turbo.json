{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/telemetry-go/**/*.go",
        "!$TURBO_ROOT$/packages/telemetry-go/**/*_test.go",
        "$TURBO_ROOT$/packages/telemetry-go/go.mod",
        "$TURBO_ROOT$/packages/telemetry-go/go.sum"
      ]
    },
    // The idempotency tests run against development's PostgreSQL, in a
    // database of their own.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/scripts/test-postgres.sh",
        "$TURBO_ROOT$/packages/telemetry-go/**/*.go",
        "!$TURBO_ROOT$/packages/telemetry-go/**/*_test.go",
        "$TURBO_ROOT$/packages/telemetry-go/go.mod",
        "$TURBO_ROOT$/packages/telemetry-go/go.sum"
      ],
      "env": ["DATABASE_URL"]
    }
  }
}
