{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    },
    // The idempotency tests run against development's PostgreSQL, in a
    // database of their own.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ],
      "env": ["DATABASE_URL"]
    }
  }
}
