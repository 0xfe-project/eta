{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*-go/**",
        "!$TURBO_ROOT$/packages/*-go/.turbo/**",
        "!$TURBO_ROOT$/packages/*-go/out/**",
        "!$TURBO_ROOT$/packages/*-go/node_modules/**"
      ]
    }
  }
}
