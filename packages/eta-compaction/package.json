{
	"name": "@eta/compaction",
	"version": "0.1.0",
	"description": "The compaction summarizer for eta: cuts the history at a turn boundary, folds a summary through the model's own window, and digests what it cannot summarize.",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest --run --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"smoke": "bun run --cwd ../eta-harness smoke"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"dependencies": {
		"@eta/core": "*",
		"@eta/harness": "*",
		"@earendil-works/pi-ai": "0.85.1"
	}
}
