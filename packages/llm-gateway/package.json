{
  "name": "@eta/llm-gateway",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The LLM gateway: CLIProxyAPI embedded in a Go shared library, loaded by the host through bun:ffi.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/fake-upstream.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "go build -buildmode=c-shared -o lib/libllm-gateway.so ./ffi",
    "typecheck": "bun check && go vet ./... && test -z \"$(gofmt -l .)\"",
    "lint": "eslint .",
    "test": "go test ./... && bun --bun vitest --run"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "bun-types": "1.4.2",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
