{
  "name": "@eta/storage-jsonl",
  "version": "0.1.0",
  "description": "JSONL session log storage for eta: fsync'd appends, atomic compactJournal, torn-tail repair.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest --run --passWithNoTests",
