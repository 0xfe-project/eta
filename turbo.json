{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  // Vercel Remote Cache, shared by every checkout (worktrees included) and CI:
  // a commit's pre-commit run uploads, so CI mostly replays. Each machine
  // authenticates itself (`turbo login`; CI exchanges its OIDC token).
  "remoteCache": { "teamId": "team_m0cGPvm66wsuOjDpnCrXUDPz" },
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  // --affected stays package-level (affectedUsingTaskInputs off): the libraries
  // are read from source, so a change must reach every dependent package.
  "futureFlags": {
    "filterUsingTasks": true,
    "strictTaskEntrypointSelection": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "tasks": {
    // Does nothing (no package has the script); its hash stands for the package's
    // files and, through ^transit, every workspace it depends on. The libraries are
    // read from source, so a task that reads them depends on it: through build, so
    // do typecheck and test.
    "transit": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": ["^transit"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": ["transit"],
      "outputs": ["dist/**", "out/**", "lib/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": ["build"],
      "outputs": []
    },
    // ESLint reads one file at a time, without types.
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/eslint.config.js"
      ],
      "outputs": []
    },
    // The LLM gateway's tests (and the host's, which load it) need its library built.
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    // The pre-commit's tests: only those that import an uncommitted change (`vitest --changed
    // HEAD`), the whole suite when a config or package.json changed. Which tests that is depends
    // on the working tree, not on the package's files, so nothing is cached. `bun run check` and
    // CI run `test`.
    "test:changed": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    // The root package's files are the whole repository; ESLint lints those outside
    // the workspaces (each workspace lints itself), knip all of it.
    "//#lint:repo": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!apps/**", "!packages/**"],
      "outputs": []
    },
    "//#knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
