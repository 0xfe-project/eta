{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    // Knip reads the whole repository, so it always runs.
    "//#knip": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
