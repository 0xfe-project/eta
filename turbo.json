{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    // Per-platform artifacts that images copy. The target platform is part of
    // the task name, so the cache key and output directory never depend on the
    // host that builds them. Packages narrow the inputs in their turbo.json.
    "build:linux-amd64": {
      "outputs": ["out/linux-amd64/**"]
    },
    "build:linux-arm64": {
      "outputs": ["out/linux-arm64/**"]
    },
    // Images from those artifacts (scripts/build/image.sh). Docker's layer
    // cache already skips unchanged work, so they always run.
    "image:linux-amd64": {
      "dependsOn": ["build:linux-amd64"],
      "cache": false,
      "passThroughEnv": ["AXP_RUNTIME_IMAGE"]
    },
    "image:linux-arm64": {
      "dependsOn": ["build:linux-arm64"],
      "cache": false,
      "passThroughEnv": ["AXP_RUNTIME_IMAGE"]
    },
    // The production app image (deploy/Dockerfile) copies these artifacts.
    "//#image:linux-amd64": {
      "dependsOn": [
        "@axp/web#build",
        "@axp/control-plane#build:linux-amd64",
        "@axp/llm-gateway#build:linux-amd64"
      ],
      "cache": false,
      "passThroughEnv": ["AXP_APP_IMAGE"]
    },
    "//#image:linux-arm64": {
      "dependsOn": [
        "@axp/web#build",
        "@axp/control-plane#build:linux-arm64",
        "@axp/llm-gateway#build:linux-arm64"
      ],
      "cache": false,
      "passThroughEnv": ["AXP_APP_IMAGE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
