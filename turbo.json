{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  // Vercel Remote Cache, shared by every checkout (worktrees included) and CI:
  // a commit's pre-commit run uploads, so CI mostly replays. Each machine
  // authenticates itself (`turbo login`; CI exchanges its OIDC token).
  "remoteCache": { "teamId": "team_m0cGPvm66wsuOjDpnCrXUDPz" },
  "cacheMaxAge": "7d",
  "cacheMaxSize": "2GB",
  // --affected stays package-level (affectedUsingTaskInputs off): the libraries
  // are read from source, so a change must reach every dependent package.
  "futureFlags": {
    "filterUsingTasks": true,
    "strictTaskEntrypointSelection": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**", "out/**", "lib/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    // The LLM gateway's tests (and the host's, which load it) need its library built.
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    // Root-level ESLint for files outside the workspaces (each workspace lints
    // itself).
    "//#lint:repo": {
      "inputs": [
        "*.{js,mjs,ts,json,jsonc}",
        "deploy/**/*.{js,mjs,ts,json,jsonc}",
        "scripts/**/*.{js,mjs,ts,json,jsonc}"
      ],
      "outputs": []
    },
    // The install scripts (POSIX sh and PowerShell), run by their tests against a fake
    // release server. Which of the tests run depends on the machine (PowerShell only on
    // Windows, dash and mawk on Linux), so the platform is part of the hash: the variables
    // install.ps1 tells Windows by, and the platform and architecture that
    // `//#test:install:platform` writes just before.
    "//#test:install:platform": {
      "cache": false
    },
    "//#test:install": {
      "dependsOn": ["//#test:install:platform"],
      "inputs": [
        "scripts/install/**",
        {
          "mode": "jit",
          "globs": ["node_modules/.cache/eta-install-platform.json"]
        }
      ],
      "env": ["OS", "PROCESSOR_ARCHITECTURE", "PROCESSOR_ARCHITEW6432"],
      "outputs": []
    },
    "//#typecheck:install": {
      "inputs": ["scripts/install/**/*.{ts,json}"],
      "outputs": []
    },
    // Knip checks the TypeScript/JavaScript workspaces and root configs.
    "//#knip": {
      "inputs": [
        "package.json",
        "bun.lock",
        "knip.config.ts",
        "eslint.config.js",
        "apps/*/{package,tsconfig}.json",
        "apps/*/{src,test,tests,.storybook}/**/*.{ts,tsx,js,mjs,css}",
        "apps/*/*.{ts,js,mjs}",
        "packages/*/package.json",
        "packages/*/{src,test,tests}/**/*.{ts,tsx,js,mjs}",
        "packages/*/*.{ts,js,mjs}",
        "apps/*/public/**/*.js",
        "!**/*.gen.ts"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
